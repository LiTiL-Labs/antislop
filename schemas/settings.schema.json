{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anti-slop local settings 0.3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "provider_id": {
      "enum": [
        "codex",
        "claude-code"
      ]
    },
    "shortcut": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "display_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "modifiers": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 5,
              "items": {
                "enum": [
                  "command",
                  "option",
                  "control",
                  "shift",
                  "function"
                ]
              }
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "key_code",
            "display_label",
            "modifiers",
            "enabled"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "detect_shortcut": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "display_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "modifiers": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 5,
              "items": {
                "enum": [
                  "command",
                  "option",
                  "control",
                  "shift",
                  "function"
                ]
              }
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "key_code",
            "display_label",
            "modifiers",
            "enabled"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "writing_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sentence_complexity": {
          "enum": [
            "caveman",
            "plain",
            "balanced",
            "polished",
            "lawyer"
          ]
        }
      },
      "required": [
        "sentence_complexity"
      ]
    },
    "style_guide": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          },
          "required": [
            "label",
            "text"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "model_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "reasoning": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "model",
            "reasoning"
          ]
        },
        "claude-code": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "reasoning": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "model",
            "reasoning"
          ]
        }
      }
    },
    "launch_at_login": {
      "type": "boolean"
    },
    "intelligence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": {
          "enum": [
            "room_temp",
            "average",
            "smart",
            "genius"
          ]
        },
        "claude-code": {
          "enum": [
            "room_temp",
            "average",
            "smart",
            "genius"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "provider_id",
    "shortcut",
    "writing_preferences",
    "style_guide",
    "launch_at_login"
  ]
}
