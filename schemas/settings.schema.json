{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anti-slop local settings 0.2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "provider_id": {
      "enum": [
        "codex",
        "claude-code"
      ]
    },
    "shortcut": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "key_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "display_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "modifiers": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 5,
              "items": {
                "enum": [
                  "command",
                  "option",
                  "control",
                  "shift",
                  "function"
                ]
              }
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "key_code",
            "display_label",
            "modifiers",
            "enabled"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "style_profile_id": {
      "enum": [
        "none",
        "no-ai-slop",
        "humanizer"
      ]
    },
    "writing_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simplify_wording": {
          "type": "boolean"
        },
        "keep_my_tone": {
          "type": "boolean"
        },
        "avoid_em_dashes": {
          "type": "boolean"
        }
      },
      "required": [
        "simplify_wording",
        "keep_my_tone",
        "avoid_em_dashes"
      ]
    },
    "custom_writer_instructions": {
      "type": "string",
      "minLength": 0,
      "maxLength": 4000
    },
    "style_guide": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          },
          "required": [
            "label",
            "text"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "provider_id",
    "shortcut",
    "style_profile_id",
    "writing_preferences",
    "custom_writer_instructions",
    "style_guide"
  ]
}
